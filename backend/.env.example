# Copia este archivo a backend/.env (nunca lo subas a git)
PORT=5000
CORS_ORIGIN=http://localhost:3000
# Activar cuando corre detrás de Nginx / reverse proxy para aislar rate limit por IP real
TRUST_PROXY=false

# Proveedor de diagnóstico: "rules" (motor local, sin IA) o "claude" (requiere API key)
AI_PROVIDER=rules
ANTHROPIC_API_KEY=
# Modelo de Claude (opcional). Por defecto: claude-opus-5-5
AI_MODEL=
# Tiempo máximo de espera del proveedor antes de responder 503 (ms)
AI_TIMEOUT_MS=30000

# Límite de solicitudes por IP a /api/maintenance/check
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
